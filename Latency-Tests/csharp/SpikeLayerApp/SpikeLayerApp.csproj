<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- McsUsbNet.dll is a Windows .NET Framework (C++/CLI) library, so target .NET Framework 4.8, 64-bit. -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tell the compiler where McsUsbNet.dll is, and copy it next to the exe on build. -->
    <Reference Include="McsUsbNet">
      <HintPath>..\..\..\Hardware-Pythonnet-Path\McsUsbNet.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- Lets the .NET SDK build net48 on machines without .NET Framework installed (e.g. macOS). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
